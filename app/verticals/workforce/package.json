{
  "name": "@app/workforce",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/workforce-client.ts",
    "./resources/worker": "./shared/resources/worker.ts",
    "./locales/cs": "./locales/cs/workforce.json",
    "./locales/en": "./locales/en/workforce.json"
  },
  "scripts": {
    "dev": "node ../../scripts/prepare-dev-module-contract.mts workforce && modern dev",
    "build": "modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical workforce --target dist && node ../../scripts/generate-public-surface-assets.mts --app workforce --target dist && cross-env MODERNJS_DEPLOY=node modern deploy --skip-build",
    "cloudflare:build": "cross-env MODERNJS_DEPLOY=cloudflare modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical workforce --target cloudflare-dist && node ../../scripts/generate-public-surface-assets.mts --app workforce --target cloudflare-dist && cross-env MODERNJS_DEPLOY=cloudflare modern deploy --skip-build && node ../../scripts/verify-cloudflare-output.mts --app workforce",
    "cloudflare:deploy": "cross-env ULTRAMODERN_CLOUDFLARE_REQUIRE_PUBLIC_URLS=true pnpm run cloudflare:build && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "node ../../scripts/proof-cloudflare-version.mts --app workforce",
    "serve": "modern serve",
    "typecheck": "node ../../scripts/ultramodern-typecheck.mts --project tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "test:unit": "rstest --project unit",
    "test:component": "rstest --project component",
    "test:integration": "rstest --project integration",
    "test:types": "node ../../scripts/ultramodern-typecheck.mts --project tests/tsconfig.json && node ../../scripts/ultramodern-typecheck.mts --project tsconfig.tooling.json"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@modern-js/bff-effect": "npm:@bleedingdev/modern-js-bff-effect@3.9.0-ultramodern.12",
    "@modern-js/federation-runtime": "npm:@bleedingdev/modern-js-federation-runtime@3.9.0-ultramodern.12",
    "@modern-js/i18n-integration": "npm:@bleedingdev/modern-js-i18n-integration@3.9.0-ultramodern.12",
    "@modern-js/plugin-bff": "npm:@bleedingdev/modern-js-plugin-bff@3.9.0-ultramodern.12",
    "@modern-js/plugin-bff-extensions": "npm:@bleedingdev/modern-js-plugin-bff-extensions@3.9.0-ultramodern.12",
    "@modern-js/plugin-i18n": "npm:@bleedingdev/modern-js-plugin-i18n@3.9.0-ultramodern.12",
    "@modern-js/plugin-tanstack": "npm:@bleedingdev/modern-js-plugin-tanstack@3.9.0-ultramodern.12",
    "@modern-js/runtime": "npm:@bleedingdev/modern-js-runtime@3.9.0-ultramodern.12",
    "@modern-js/runtime-extensions": "npm:@bleedingdev/modern-js-runtime-extensions@3.9.0-ultramodern.12",
    "@modern-js/runtime-renderer-extensions": "npm:@bleedingdev/modern-js-runtime-renderer-extensions@3.9.0-ultramodern.12",
    "@module-federation/modern-js-v3": "2.9.0",
    "@module-federation/runtime": "2.9.0",
    "@tanstack/react-router": "1.170.33",
    "effect": "4.0.0-rc.112",
    "i18next": "26.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@effect/sql-pg": "4.0.0-rc.112",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "pg": "8.22.0",
    "@techsio/ui-kit": "0.25.1",
    "@app/service-jobs": "workspace:*"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@modern-js/app-tools": "npm:@bleedingdev/modern-js-app-tools@3.9.0-ultramodern.12",
    "@modern-js/app-tools-extensions": "npm:@bleedingdev/modern-js-app-tools-extensions@3.9.0-ultramodern.12",
    "@modern-js/plugin-bff-build-extensions": "npm:@bleedingdev/modern-js-plugin-bff-build-extensions@3.9.0-ultramodern.12",
    "@modern-js/ultramodern-app-tools": "npm:@bleedingdev/modern-js-ultramodern-app-tools@3.9.0-ultramodern.12",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "cross-env": "10.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.116.0",
    "zephyr-rspack-plugin": "1.2.4",
    "@types/pg": "8.20.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@f29b3f495d45a11037334620bf5f693414fb5578",
    "@rstest/core": "0.11.12",
    "@modern-js/adapter-rstest": "npm:@bleedingdev/modern-js-adapter-rstest@3.9.0-ultramodern.12",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "happy-dom": "20.8.3"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "workforce",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "workforce.planning",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {},
  "type": "module"
}
