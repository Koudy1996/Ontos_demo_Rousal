    {
      "value": "\"date_to\" >= \"date_from\"",
      "name": "absence_dates_valid",
      "entityType": "checks",
      "schema": "workforce",
      "table": "absences"
    },
    {
      "value": "\"reason\" IN ('VACATION','SICK','OTHER')",
      "name": "absence_reason_valid",
      "entityType": "checks",
      "schema": "workforce",
      "table": "absences"
    },
    {
      "value": "length(trim(\"display_name\")) > 0 AND length(\"display_name\") <= 500",
      "name": "workers_name_valid",
      "entityType": "checks",
      "schema": "workforce",
      "table": "workers"
    },
    {
      "value": "\"status\" IN ('ACTIVE','INACTIVE')",
      "name": "workers_status_valid",
      "entityType": "checks",
      "schema": "workforce",
      "table": "workers"
    },
    {
      "value": "\"agreement_type\" IN ('EMPLOYMENT','DPP','DPC','CONTRACTOR') AND (\"agreement_valid_to\" IS NULL OR \"agreement_valid_to\" >= \"agreement_valid_from\")",
      "name": "workers_agreement_valid",
      "entityType": "checks",
      "schema": "workforce",
      "table": "workers"
    },
    {
      "value": "\"internal_hourly_cost_czk\" IS NULL OR \"internal_hourly_cost_czk\" >= 0",
      "name": "workers_cost_valid",
      "entityType": "checks",
      "schema": "workforce",
      "table": "workers"
    },
    {
      "value": "\"revision\" > 0",
      "name": "workers_revision_positive",
      "entityType": "checks",
      "schema": "workforce",
      "table": "workers"
    },
