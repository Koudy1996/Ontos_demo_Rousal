    {
      "value": "\"revision\" > 0 AND \"source_revision\" > 0",
      "name": "jobs_revision_positive",
      "entityType": "checks",
      "schema": "service_jobs",
      "table": "jobs"
    },
    {
      "value": "\"status\" IN ('NEW','PLANNED','IN_PROGRESS','COMPLETED')",
      "name": "jobs_status_valid",
      "entityType": "checks",
      "schema": "service_jobs",
      "table": "jobs"
    },
    {
      "value": "\"status\" = 'NEW' OR \"scheduled_start_at\" IS NOT NULL",
      "name": "jobs_schedule_present",
      "entityType": "checks",
      "schema": "service_jobs",
      "table": "jobs"
    },
    {
      "value": "(\"status\" IN ('NEW','PLANNED') AND \"started_at\" IS NULL) OR (\"status\" IN ('IN_PROGRESS','COMPLETED') AND \"started_at\" IS NOT NULL)",
      "name": "jobs_started_present",
      "entityType": "checks",
      "schema": "service_jobs",
      "table": "jobs"
    },
    {
      "value": "(\"status\" = 'COMPLETED') = (\"completed_at\" IS NOT NULL)",
      "name": "jobs_completed_present",
      "entityType": "checks",
      "schema": "service_jobs",
      "table": "jobs"
    },
    {
      "value": "\"expected_duration_minutes\" IS NULL OR \"expected_duration_minutes\" BETWEEN 1 AND 10080",
      "name": "jobs_duration_valid",
      "entityType": "checks",
      "schema": "service_jobs",
      "table": "jobs"
    },
