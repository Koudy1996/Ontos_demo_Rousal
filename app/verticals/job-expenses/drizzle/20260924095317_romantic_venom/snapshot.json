    {
      "value": "\"amount_czk\" > 0",
      "name": "job_expenses_amount_positive",
      "entityType": "checks",
      "schema": "job_expenses",
      "table": "job_expenses"
    },
    {
      "value": "\"category\" IN ('WORK','TRANSPORT','DISPOSAL','MATERIAL','OTHER')",
      "name": "job_expenses_category_valid",
      "entityType": "checks",
      "schema": "job_expenses",
      "table": "job_expenses"
    },
    {
      "value": "length(trim(\"description\")) > 0 AND length(\"description\") <= 500",
      "name": "job_expenses_description_valid",
      "entityType": "checks",
      "schema": "job_expenses",
      "table": "job_expenses"
    },
    {
      "value": "\"currency\" = 'CZK'",
