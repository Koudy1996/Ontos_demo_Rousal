      "entityType": "checks",
      "schema": "job_expenses",
      "table": "job_expenses"
    },
    {
      "value": "\"cost_basis\" = 'EXCLUDING_VAT'",
      "name": "job_expenses_cost_basis_valid",
      "entityType": "checks",
      "schema": "job_expenses",
      "table": "job_expenses"
    },
    {
      "value": "\"status\" IN ('RECORDED','VOIDED')",
      "name": "job_expenses_status_valid",
      "entityType": "checks",
      "schema": "job_expenses",
      "table": "job_expenses"
    },
    {
      "value": "\"revision\" > 0",
      "name": "job_expenses_revision_positive",
      "entityType": "checks",
      "schema": "job_expenses",
      "table": "job_expenses"
    },
    {
      "value": "(\"status\" = 'RECORDED' AND \"voided_at\" IS NULL AND \"void_reason\" IS NULL) OR (\"status\" = 'VOIDED' AND \"voided_at\" IS NOT NULL AND length(trim(\"void_reason\")) > 0 AND length(\"void_reason\") <= 500)",
