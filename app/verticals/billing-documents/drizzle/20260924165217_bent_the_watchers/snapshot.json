      "table": "invoices"
    },
    {
      "value": "\"invoice_year\" between 1 and 9999",
      "name": "billing_documents_counter_year_ck",
      "entityType": "checks",
      "schema": "billing_documents",
      "table": "invoice_number_counters"
    },
    {
      "value": "\"last_number\" between 1 and 999999",
      "name": "billing_documents_counter_value_ck",
      "entityType": "checks",
      "schema": "billing_documents",
      "table": "invoice_number_counters"
    },
    {
      "value": "\"status\" in ('DRAFT', 'ISSUED')",
      "name": "billing_documents_invoice_status_ck",
      "entityType": "checks",
      "schema": "billing_documents",
      "table": "invoices"
    },
    {
      "value": "\"commercial_total\" >= 0",
      "name": "billing_documents_invoice_amount_ck",
      "entityType": "checks",
      "schema": "billing_documents",
      "table": "invoices"
    },
    {
      "value": "\"commercial_currency\" ~ '^[A-Z]{3}$'",
      "name": "billing_documents_invoice_currency_ck",
      "entityType": "checks",
      "schema": "billing_documents",
      "table": "invoices"
    },
    {
      "value": "\"commercial_price_basis\" in ('INCLUDING_VAT', 'EXCLUDING_VAT')",
      "name": "billing_documents_invoice_price_basis_ck",
      "entityType": "checks",
      "schema": "billing_documents",
      "table": "invoices"
    },
    {
      "value": "length(btrim(\"description\")) between 1 and 500",
      "name": "billing_documents_invoice_description_ck",
      "entityType": "checks",
      "schema": "billing_documents",
      "table": "invoices"
    },
    {
      "value": "\"revision\" > 0",
      "name": "billing_documents_invoice_revision_ck",
      "entityType": "checks",
      "schema": "billing_documents",
      "table": "invoices"
    },
    {
      "value": "(\"status\" = 'DRAFT' and \"invoice_number\" is null and \"issued_at\" is null and \"due_at\" is null and \"recipient_snapshot\" is null and \"payment_term_snapshot\" is null and \"issuer_snapshot\" is null) or (\"status\" = 'ISSUED' and \"invoice_number\" is not null and \"issued_at\" is not null and \"due_at\" is not null and \"recipient_snapshot\" is not null and \"payment_term_snapshot\" is not null and \"issuer_snapshot\" is not null)",
      "name": "billing_documents_invoice_lifecycle_ck",
      "entityType": "checks",
      "schema": "billing_documents",
      "table": "invoices"
    },
